# =========================================================
# MarketElite Environment Configuration Template
# Copy this file to `.env` and fill in your own keys.
# NEVER commit `.env` to Git!
# =========================================================

# --- Application ---
APP_NAME=MarketElite
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- PostgreSQL (pgvector) & Redis ---
POSTGRES_USER=marketelite
POSTGRES_PASSWORD=marketelite_dev
POSTGRES_DB=marketelite
DATABASE_URL=postgresql+psycopg://marketelite:marketelite_dev@localhost:5432/marketelite
CHECKPOINT_DB_URI=postgresql://marketelite:marketelite_dev@localhost:5432/marketelite?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- Observability (Arize Phoenix) ---
ENABLE_TELEMETRY=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_UI_URL=http://localhost:6006

# --- Market Data & Macro APIs ---
# Required in Phase 1+ (You already have Alpaca!)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Free email signup keys (Phase 1)
FRED_API_KEY=
FINNHUB_API_KEY=
FMP_API_KEY=

# Keyless SEC EDGAR compliance header (replace with your real app name & email)
SEC_EDGAR_USER_AGENT=MarketElite Research contact@example.com

# --- LLM Router (OpenAI-Compatible Unified Gateway) ---
# Phase 0-2 dev default can use Gemini Free / Aliyun Bailian / Groq;
# Phase 2+ prod recommended: DeepSeek / Qwen with Context Caching
LLM_FAST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FAST_API_KEY=
LLM_FAST_MODEL=gemini-2.5-flash

LLM_PRO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRO_API_KEY=
LLM_PRO_MODEL=gemini-2.5-flash
