# =========================================================
# MarketElite v1.0 Environment Configuration Template
# Copy this file to `.env` and customize as needed.
# NEVER commit your real `.env` file to Git!
#
# Zero-Key OSS Quick Start:
#   Even with ALL third-party API keys left blank below, MarketElite
#   auto-populates a sanitized demo snapshot on cold start + works with:
#   - 24/7 Local Sandbox Paper Ledger & Risk Critic Bracket Sizing (0-Token)
#   - Bull vs Bear CRO Stress Test Debate (Deterministic mode)
#   - 4-Track Eval Hub & DataOps Observability
#   - Keyless FRED CSV macro fallback & Browser-local BYOK LLM keys
# =========================================================

# --- 1. Application & CORS (Conflict-free dedicated ports) ---
APP_NAME=MarketElite
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8100
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100

# --- 2. PostgreSQL (pgvector on 5433) & Redis (on 6380) ---
POSTGRES_USER=marketelite
POSTGRES_PASSWORD=marketelite_dev
POSTGRES_DB=marketelite
DATABASE_URL=postgresql+psycopg://marketelite:marketelite_dev@localhost:5433/marketelite
CHECKPOINT_DB_URI=postgresql://marketelite:marketelite_dev@localhost:5433/marketelite?sslmode=disable
REDIS_URL=redis://localhost:6380/0

# --- 3. Observability (Arize Phoenix on 6007 / OTLP 4318) ---
ENABLE_TELEMETRY=true
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6007/v1/traces
PHOENIX_UI_URL=http://localhost:6007

# --- 4. Optional Free Market & Macro API Keys (Apply free keys to unlock live feeds) ---
# Alpaca Paper Trading & SIP/Indicative Options (https://app.alpaca.markets/signup)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# FRED Macro & Liquidity API (https://fred.stlouisfed.org/docs/api/api_key.html - optional; CSV fallback works without key)
FRED_API_KEY=
# Finnhub Earnings & EPS Revisions (https://finnhub.io/register - free tier)
FINNHUB_API_KEY=
# Financial Modeling Prep Economic Calendar (https://site.financialmodelingprep.com/developer/docs - optional)
FMP_API_KEY=

# Keyless SEC EDGAR compliance header (replace with your app name & contact email before live SEC calls)
SEC_EDGAR_USER_AGENT=MarketElite Research contact@example.com

# --- 5. Optional Trading212 / Broker Env Defaults (Or configure securely per-browser in Settings UI) ---
BROKER_PROVIDER=auto
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENV=live
TRADING212_READ_ONLY=true

# --- 6. LLM Router (OpenAI-Compatible Gateway; recommended: configure via UI BYOK in browser localStorage) ---
LLM_FAST_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FAST_API_KEY=
LLM_FAST_MODEL=gemini-2.5-flash

LLM_PRO_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRO_API_KEY=
LLM_PRO_MODEL=gemini-2.5-flash

LLM_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_MODEL=gemini-embedding-001
LLM_EMBEDDING_DIM=1536

# Keep false for public/shared deployments so guests use browser-local BYOK keys
# instead of consuming server `.env` LLM credits.
ALLOW_SERVER_LLM_FALLBACK=false

# --- 7. Agent Guardrails & Public Portfolio Hardening (Positioning A) ---
AGENT_MAX_STEPS=8
AGENT_WALL_TIMEOUT_SECONDS=45
AGENT_MAX_CONTEXT_TOKENS=14000
GUEST_CHAT_RPM=12

# Protect pipeline sync, live paper order execution, and Data/Eval mutations on public servers
ADMIN_API_TOKEN=
# Set true for public portfolio showcase deployments: visitors get full read-only DataOps & Eval observability,
# while trigger/reset mutations stay locked behind X-Admin-Token.
PUBLIC_SHOWCASE_READONLY=false
